# Set only to the real production HTTPS origin, with no trailing path.
NEXT_PUBLIC_SITE_URL=
# GitHub project Pages path; empty for local development or a domain-root deployment.
NEXT_PUBLIC_BASE_PATH=
# Public author inbox for manual email drafting. This is not a secret/API credential.
NEXT_PUBLIC_CONTACT_EMAIL=
# Reserved for a future SERVER deployment. These cannot enable contact on GitHub Pages.
# Resend: verified sending domain and approved destination inbox.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Upstash Redis: server-side durable spam rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a long random secret, stored only in your hosting secrets manager.
CONTACT_HASH_SECRET=
# Enable only after owner-approved final privacy notice and verified proxy IP handling.
CONTACT_PRIVACY_APPROVED=false
